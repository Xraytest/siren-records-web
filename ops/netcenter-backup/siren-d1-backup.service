[Unit]
Description=SIREN RECORDS 云端 D1 数据库备份（拉取 + 校验 + 轮转）
Documentation=https://siren.neolx.ltd
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=oneshot
SyslogIdentifier=siren-d1-backup
# @DEST@ 由 install.sh 按 SIREN_BACKUP_HOME 替换：早期版本这里写死 %h/siren-backup，
# 换目录安装时定时器会指向不存在的脚本。
WorkingDirectory=@DEST@
ExecStart=/usr/bin/env bash @DEST@/backup-d1.sh
TimeoutStartSec=900
Nice=10
IOSchedulingClass=idle

# 最小权限沙箱（与 frpc-ali01.service 同风格）
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DEST@
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
# AF_UNIX 是 gpg-agent 的 unix socket 与 nss 解析走的族：没有它 GPG 备份会每晚失败
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=256M
TasksMax=64
# GPG 需要可写的 keyring 状态目录；默认 ~/.gnupg 在 ProtectHome=read-only 下不可写
Environment=GNUPGHOME=@DEST@/gnupg
