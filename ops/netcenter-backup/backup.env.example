# SIREN RECORDS · NetCenter 备份配置
#
# 复制为 backup.env 后 chmod 600，并填入 32+ 字符的随机令牌。
# 令牌由 Cloudflare Worker 的 secret BACKUP_TOKEN 决定，两端必须一致。
#
#   openssl rand -hex 32     # 生成令牌（在 NetCenter 上执行）

SIREN_BACKUP_URL=https://siren.neolx.ltd/api/backup/dump
SIREN_BACKUP_TOKEN=REPLACE_WITH_64_HEX_CHARS

# 可选：备份落盘目录（默认与本脚本同级的 dumps/；必须与 state/ 同盘，df 守卫才准）
# SIREN_BACKUP_DIR=/home/pi/siren-backup/dumps

# 可选：保留最近 N 份，以及更早的每月保留最新 1 份、最多 M 个月
# 整数不要写前导零（08 会被 bash 当八进制，脚本会直接拒绝并说明原因）
# SIREN_BACKUP_KEEP_DAILY=30
# SIREN_BACKUP_KEEP_MONTHLY=12
# SIREN_BACKUP_MIN_FREE_MB=1024
# 备份里的用户数低于该下限就判为失败（默认 1；确有空库阶段才设 0）
# SIREN_BACKUP_MIN_USERS=1

# 可选：用 GPG 公钥加密落盘（必须同时备份私钥，否则恢复不了）
# SIREN_BACKUP_GPG_RECIPIENT=backup@example.com
