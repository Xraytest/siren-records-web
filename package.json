{
  "name": "siren-records-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cf": "wrangler dev",
    "server": "node server/server.mjs",
    "build": "tsc -b && vite build",
    "test": "node --test \"tests/*.test.mts\"",
    "deploy": "npm run build && wrangler deploy",
    "deploy:safe": "node scripts/deploy-safe.mjs",
    "db:migrate": "wrangler d1 migrations apply siren-records --remote",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "playwright": "^1.56.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wrangler": "^4.154.0"
  }
}
