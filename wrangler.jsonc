{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siren-records-web",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "ebfbeefc8f6cd5c3d9b305332bfd5168",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 必须让静态资源也先经过 Worker：否则命中 CF 边缘缓存时
    // 直接返回缓存副本，Worker 里加的 CSP / X-Frame-Options 等响应头不会生效。
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  // Custom domain: workers.dev is SNI-blocked on some networks, so the app is
  // served from siren.neolx.ltd. workers.dev stays enabled for overseas access
  // and for old links.
  "workers_dev": true,
  "routes": [
    {
      "pattern": "siren.neolx.ltd",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "siren-records",
      "database_id": "99305b68-08ef-4df0-b00d-10e829e9ccfa",
      "migrations_dir": "migrations"
    }
  ]
}
